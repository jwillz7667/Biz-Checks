{
  "name": "@biz-checks/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "prisma generate && tsc -b",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/src/server.js",
    "start:local": "node --env-file=.env dist/src/server.js",
    "start:prod": "prisma migrate deploy && node dist/src/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@biz-checks/check-engine": "workspace:*",
    "@biz-checks/domain": "workspace:*",
    "@biz-checks/formula": "workspace:*",
    "@biz-checks/micr": "workspace:*",
    "@pdf-lib/fontkit": "^1.1.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.2",
    "@fastify/under-pressure": "^9.0.3",
    "@prisma/client": "^6.0.1",
    "argon2": "^0.41.1",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.4.2",
    "pdf-lib": "^1.17.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biz-checks/eslint-config": "workspace:*",
    "@biz-checks/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
