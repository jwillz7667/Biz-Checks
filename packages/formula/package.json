{
  "name": "@biz-checks/formula",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@biz-checks/domain": "workspace:*"
  },
  "devDependencies": {
    "@biz-checks/tsconfig": "workspace:*",
    "@biz-checks/eslint-config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
