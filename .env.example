# Server
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_PORT=3000

# Public URLs
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/biz_checks?schema=public
DATABASE_POOL_SIZE=10

# Redis (for sessions, idempotency, rate limiting)
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 64
JWT_SECRET=replace-me-with-64-bytes-of-random-base64
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Field-level encryption — generate with: openssl rand -base64 32 (must be 32 bytes / 256 bits)
ENCRYPTION_KEY=replace-me-with-32-bytes-of-random-base64
ENCRYPTION_KEY_VERSION=1

# Object storage (S3-compatible: AWS S3, R2, MinIO)
STORAGE_BUCKET=biz-checks-signatures
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# Front-end (Next.js public)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME="BizChecks"
